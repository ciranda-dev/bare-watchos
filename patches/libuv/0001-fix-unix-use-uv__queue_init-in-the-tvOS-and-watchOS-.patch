From 6a75786fd3e02f5840669f610a11fa5d032db92f Mon Sep 17 00:00:00 2001
From: Daniel de Souza Neris <danielneris01@gmail.com>
Date: Sat, 7 Nov 2026 13:54:52 +0700
Subject: [PATCH] fix(unix): use uv__queue_init in the tvOS and watchOS
 uv_spawn stub

The stub that tvOS and watchOS build instead of uv_spawn() still called
QUEUE_INIT(), which was removed with the move to struct uv__queue, so
src/unix/process.c failed to compile for either platform.

Refs: https://github.com/libuv/libuv/pull/4022
---
 src/unix/process.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/unix/process.c b/src/unix/process.c
index 5d8d6fa2..04a914b6 100644
--- a/src/unix/process.c
+++ b/src/unix/process.c
@@ -1038,7 +1038,7 @@ int uv_spawn(uv_loop_t* loop,
 #if defined(__APPLE__) && (TARGET_OS_TV || TARGET_OS_WATCH)
   /* fork is marked __WATCHOS_PROHIBITED __TVOS_PROHIBITED. */
   uv__handle_init(loop, (uv_handle_t*)process, UV_PROCESS);
-  QUEUE_INIT(&process->queue);
+  uv__queue_init(&process->queue);
   process->status = 0;
   process->pid = 0;
   return UV_ENOSYS;
