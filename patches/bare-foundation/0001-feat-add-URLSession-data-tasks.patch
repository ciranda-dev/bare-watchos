new file mode 100644
index 0000000..b380d9c
--- /dev/null
+++ b/lib/url-session.h
@@ -0,0 +1,145 @@
+#pragma once
+
+#import <assert.h>
+#import <js.h>
+#import <stdlib.h>
+
+#import <Foundation/Foundation.h>
+
+#import "registry.h"
+#import "url-request.h"
+
+typedef struct {
+  js_threadsafe_function_t *tsfn;
+
+  CFTypeRef data;
+  CFTypeRef response;
+  CFTypeRef error;
+} bare_foundation_url_session__completion_t;
+
+static void
+bare_foundation_url_session__on_complete(js_env_t *env, js_value_t *function, void *context, void *data) {
+  int err;
+
+  bare_foundation_registry_t *registry = context;
+
+  bare_foundation_url_session__completion_t *completion = data;
+
+  js_handle_scope_t *scope;
+  err = js_open_handle_scope(env, &scope);
+  assert(err == 0);
+
+  js_value_t *argv[3];
+
+  @autoreleasepool {
+    NSError *error = (__bridge NSError *) completion->error;
+
+    if (error == nil) {
+      err = js_get_null(env, &argv[0]);
+      assert(err == 0);
+    } else {
+      js_value_t *message = bare_foundation__string(env, error.localizedDescription);
+
+      err = js_create_error(env, NULL, message, &argv[0]);
+      assert(err == 0);
+
+      js_value_t *code;
+      err = js_create_int64(env, error.code, &code);
+      assert(err == 0);
+
+      err = js_set_named_property(env, argv[0], "code", code);
+      assert(err == 0);
+
+      err = js_set_named_property(env, argv[0], "domain", bare_foundation__string(env, error.domain));
+      assert(err == 0);
+    }
+
+    argv[1] = bare_foundation_bridge(env, registry, (__bridge NSURLResponse *) completion->response);
+
+    argv[2] = bare_foundation__data(env, (__bridge NSData *) completion->data);
+  }
+
+  if (completion->data) CFRelease(completion->data);
+  if (completion->response) CFRelease(completion->response);
+  if (completion->error) CFRelease(completion->error);
+
+  js_threadsafe_function_t *tsfn = completion->tsfn;
+
+  free(completion);
+
+  js_value_t *global;
+  err = js_get_global(env, &global);
+  assert(err == 0);
+
+  js_call_function(env, global, function, 3, argv, NULL);
+
+  err = js_release_threadsafe_function(tsfn, js_threadsafe_function_release);
+  assert(err == 0);
+
+  err = js_close_handle_scope(env, scope);
+  assert(err == 0);
+}
+
+static void
+bare_foundation_url_session__on_finalize(js_env_t *env, void *data, void *finalize_hint) {
+  bare_foundation_registry_release(data);
+}
+
+static js_value_t *
+bare_foundation_url_session_shared(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, NULL, NULL, NULL, (void **) &registry);
+  assert(err == 0);
+
+  return bare_foundation_bridge(env, registry, [NSURLSession sharedSession]);
+}
+
+static js_value_t *
+bare_foundation_url_session_data_task(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 3;
+  js_value_t *argv[3];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 3);
+
+  void *session;
+  if (bare_foundation_read_type(env, registry, argv[0], "handle", [NSURLSession class], &session) < 0) return NULL;
+
+  void *request;
+  if (bare_foundation_read_type(env, registry, argv[1], "request", [NSURLRequest class], &request) < 0) return NULL;
+
+  js_threadsafe_function_t *tsfn;
+  err = js_create_threadsafe_function(env, argv[2], 0, 1, bare_foundation_url_session__on_finalize, NULL, registry, bare_foundation_url_session__on_complete, &tsfn);
+  assert(err == 0);
+
+  bare_foundation_registry_retain(registry);
+
+  js_value_t *result;
+
+  @autoreleasepool {
+    NSURLSessionDataTask *task = [(__bridge NSURLSession *) session
+      dataTaskWithRequest:(__bridge NSURLRequest *) request
+        completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
+          bare_foundation_url_session__completion_t *completion = malloc(sizeof(bare_foundation_url_session__completion_t));
+
+          completion->tsfn = tsfn;
+          completion->data = data ? CFRetain((__bridge CFTypeRef) data) : NULL;
+          completion->response = response ? CFRetain((__bridge CFTypeRef) response) : NULL;
+          completion->error = error ? CFRetain((__bridge CFTypeRef) error) : NULL;
+
+          int err = js_call_threadsafe_function(tsfn, completion, js_threadsafe_function_nonblocking);
+          assert(err == 0);
+        }];
+
+    result = bare_foundation_bridge(env, registry, task);
+  }
+
+  return result;
+}
