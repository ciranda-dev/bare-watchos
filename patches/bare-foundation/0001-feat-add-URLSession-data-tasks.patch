+#pragma once
+
+#import <assert.h>
+#import <js.h>
+
+#import <Foundation/Foundation.h>
+
+#import "registry.h"
+
+static js_value_t *
+bare_foundation_url_session_data_task_resume(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_tag(env, registry, argv[0], "handle", &handle) < 0) return NULL;
+
+  [(__bridge NSURLSessionDataTask *) handle resume];
+
+  return NULL;
+}
+
+static js_value_t *
+bare_foundation_url_session_data_task_cancel(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_tag(env, registry, argv[0], "handle", &handle) < 0) return NULL;
+
+  [(__bridge NSURLSessionDataTask *) handle cancel];
+
+  return NULL;
+}
