+import Buffer from 'bare-buffer'
+import { tag, handle, Handle } from 'bare-foundation-registry'
+
+/** A request for a URL, as an `NSMutableURLRequest`. */
+interface FoundationURLRequest {
+  readonly [tag]: number
+
+  readonly [handle]: Handle
+
+  readonly url: string
+
+  /** `GET` unless you set another one. */
+  httpMethod: string
+
+  /** The body sent with the request, or `null` for none. */
+  httpBody: Buffer | null
+
+  /** The value of a header field, or `null` if it is not set. */
+  value(field: string): string | null
+
+  /** Set a header field, or remove it with `null`. */
+  setValue(value: string | null, field: string): void
+}
+
+declare class FoundationURLRequest {
+  /** @throws A `TypeError` when `url` is not a valid URL. */
+  constructor(url: string)
+}
+
+export = FoundationURLRequest
diff --git a/lib/url-request.h b/lib/url-request.h
new file mode 100644
index 0000000..2e18ace
--- /dev/null
+++ b/lib/url-request.h
@@ -0,0 +1,322 @@
+#pragma once
+
+#import <assert.h>
+#import <js.h>
+#import <stdlib.h>
+
+#import <Foundation/Foundation.h>
+
+#import "registry.h"
+
+static int
+bare_foundation__read_string(js_env_t *env, js_value_t *value, const char *name, NSString **result) {
+  int err;
+
+  bool is;
+  err = js_is_string(env, value, &is);
+  assert(err == 0);
+
+  if (!is) {
+    err = js_throw_type_errorf(env, NULL, "Expected '%s' to be a string", name);
+    assert(err == 0);
+
+    return -1;
+  }
+
+  size_t len;
+  err = js_get_value_string_utf8(env, value, NULL, 0, &len);
+  assert(err == 0);
+
+  utf8_t *str = malloc(len + 1);
+  err = js_get_value_string_utf8(env, value, str, len + 1, NULL);
+  assert(err == 0);
+
+  *result = [[[NSString alloc] initWithBytes:str length:len encoding:NSUTF8StringEncoding] autorelease];
+
+  free(str);
+
+  return 0;
+}
+
+static js_value_t *
+bare_foundation__string(js_env_t *env, NSString *string) {
+  int err;
+
+  js_value_t *result;
+
+  if (string == nil) {
+    err = js_get_null(env, &result);
+    assert(err == 0);
+  } else {
+    err = js_create_string_utf8(env, (const utf8_t *) string.UTF8String, -1, &result);
+    assert(err == 0);
+  }
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation__data(js_env_t *env, NSData *data) {
+  int err;
+
+  js_value_t *result;
+
+  if (data == nil) {
+    err = js_get_null(env, &result);
+    assert(err == 0);
+  } else {
+    void *bytes;
+    err = js_create_arraybuffer(env, data.length, &bytes, &result);
+    assert(err == 0);
+
+    memcpy(bytes, data.bytes, data.length);
+  }
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation_url_request_create(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  js_value_t *result;
+
+  @autoreleasepool {
+    NSString *string;
+    if (bare_foundation__read_string(env, argv[0], "url", &string) < 0) return NULL;
+
+    NSURL *url = [NSURL URLWithString:string];
+
+    if (url == nil) {
+      err = js_throw_type_error(env, NULL, "Invalid URL");
+      assert(err == 0);
+
+      return NULL;
+    }
+
+    result = bare_foundation_bridge(env, registry, [NSMutableURLRequest requestWithURL:url]);
+  }
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation_url_request_url(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_tag(env, registry, argv[0], "handle", &handle) < 0) return NULL;
+
+  js_value_t *result;
+
+  @autoreleasepool {
+    result = bare_foundation__string(env, ((__bridge NSURLRequest *) handle).URL.absoluteString);
+  }
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation_url_request_http_method(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_tag(env, registry, argv[0], "handle", &handle) < 0) return NULL;
+
+  js_value_t *result;
+
+  @autoreleasepool {
+    result = bare_foundation__string(env, ((__bridge NSURLRequest *) handle).HTTPMethod);
+  }
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation_url_request_set_http_method(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 2;
+  js_value_t *argv[2];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 2);
+
+  void *handle;
+  if (bare_foundation_read_type(env, registry, argv[0], "handle", [NSMutableURLRequest class], &handle) < 0) return NULL;
+
+  @autoreleasepool {
+    NSString *method;
+    if (bare_foundation__read_string(env, argv[1], "method", &method) < 0) return NULL;
+
+    ((__bridge NSMutableURLRequest *) handle).HTTPMethod = method;
+  }
+
+  return NULL;
+}
+
+static js_value_t *
+bare_foundation_url_request_http_body(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_tag(env, registry, argv[0], "handle", &handle) < 0) return NULL;
+
+  return bare_foundation__data(env, ((__bridge NSURLRequest *) handle).HTTPBody);
+}
+
+static js_value_t *
+bare_foundation_url_request_set_http_body(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 2;
+  js_value_t *argv[2];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 2);
+
+  void *handle;
+  if (bare_foundation_read_type(env, registry, argv[0], "handle", [NSMutableURLRequest class], &handle) < 0) return NULL;
+
+  bool is;
+  err = js_is_null(env, argv[1], &is);
+  assert(err == 0);
+
+  if (is) {
+    ((__bridge NSMutableURLRequest *) handle).HTTPBody = nil;
+
+    return NULL;
+  }
+
+  err = js_is_typedarray(env, argv[1], &is);
+  assert(err == 0);
+
+  if (!is) {
+    err = js_throw_type_error(env, NULL, "Expected 'body' to be a typed array or null");
+    assert(err == 0);
+
+    return NULL;
+  }
+
+  js_typedarray_type_t type;
+  void *data;
+  size_t len;
+  err = js_get_typedarray_info(env, argv[1], &type, &data, &len, NULL, NULL);
+  assert(err == 0);
+
+  if (type != js_uint8array) {
+    err = js_throw_type_error(env, NULL, "Expected 'body' to be a Uint8Array or null");
+    assert(err == 0);
+
+    return NULL;
+  }
+
+  @autoreleasepool {
+    ((__bridge NSMutableURLRequest *) handle).HTTPBody = [NSData dataWithBytes:data length:len];
+  }
+
+  return NULL;
+}
+
+static js_value_t *
+bare_foundation_url_request_value(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 2;
+  js_value_t *argv[2];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 2);
+
+  void *handle;
+  if (bare_foundation_read_tag(env, registry, argv[0], "handle", &handle) < 0) return NULL;
+
+  js_value_t *result;
+
+  @autoreleasepool {
+    NSString *field;
+    if (bare_foundation__read_string(env, argv[1], "field", &field) < 0) return NULL;
+
+    result = bare_foundation__string(env, [(__bridge NSURLRequest *) handle valueForHTTPHeaderField:field]);
+  }
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation_url_request_set_value(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 3;
+  js_value_t *argv[3];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 3);
+
+  void *handle;
+  if (bare_foundation_read_type(env, registry, argv[0], "handle", [NSMutableURLRequest class], &handle) < 0) return NULL;
+
+  @autoreleasepool {
+    NSString *field;
+    if (bare_foundation__read_string(env, argv[2], "field", &field) < 0) return NULL;
+
+    bool is;
+    err = js_is_null(env, argv[1], &is);
+    assert(err == 0);
+
+    NSString *value = nil;
+    if (!is && bare_foundation__read_string(env, argv[1], "value", &value) < 0) return NULL;
+
+    [(__bridge NSMutableURLRequest *) handle setValue:value forHTTPHeaderField:field];
+  }
+
+  return NULL;
+}
diff --git a/lib/url-request.js b/lib/url-request.js
new file mode 100644
index 0000000..05b0dfe
--- /dev/null
+++ b/lib/url-request.js
@@ -0,0 +1,48 @@
+const binding = require('../binding')
+const registry = require('bare-foundation-registry')
+
+module.exports = exports = class FoundationURLRequest {
+  constructor(url) {
+    this._tag = binding.urlRequestCreate(url)
+
+    this._token = binding.claim(this._tag, this)
+  }
+
+  get [registry.tag]() {
+    return this._tag
+  }
+
+  get [registry.handle]() {
+    return binding.handle(this._tag)
+  }
+
+  get url() {
+    return binding.urlRequestURL(this._tag)
+  }
+
+  get httpMethod() {
+    return binding.urlRequestHTTPMethod(this._tag)
+  }
+
+  set httpMethod(method) {
+    binding.urlRequestSetHTTPMethod(this._tag, method)
+  }
+
+  get httpBody() {
+    const body = binding.urlRequestHTTPBody(this._tag)
+
+    return body === null ? null : Buffer.from(body)
+  }
+
+  set httpBody(body) {
+    binding.urlRequestSetHTTPBody(this._tag, body)
+  }
+
+  value(field) {
+    return binding.urlRequestValue(this._tag, field)
+  }
+
+  setValue(value, field) {
+    binding.urlRequestSetValue(this._tag, value, field)
+  }
+}
diff --git a/lib/url-session-data-task.d.ts b/lib/url-session-data-task.d.ts
