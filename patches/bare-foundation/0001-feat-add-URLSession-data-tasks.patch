+++ b/lib/http-url-response.d.ts
@@ -0,0 +1,19 @@
+import { tag, handle, Handle } from 'bare-foundation-registry'
+
+/** The response to an HTTP request, as an `NSHTTPURLResponse`. */
+interface FoundationHTTPURLResponse {
+  readonly [tag]: number
+
+  readonly [handle]: Handle
+
+  readonly statusCode: number
+
+  /** The header fields of the response, by their names as the server sent them. */
+  readonly allHeaderFields: Record<string, string>
+}
+
+declare class FoundationHTTPURLResponse {
+  protected constructor()
+}
+
+export = FoundationHTTPURLResponse
diff --git a/lib/http-url-response.h b/lib/http-url-response.h
new file mode 100644
index 0000000..4b2db3f
--- /dev/null
+++ b/lib/http-url-response.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#import <assert.h>
+#import <js.h>
+
+#import <Foundation/Foundation.h>
+
+#import "registry.h"
+#import "url-request.h"
+
+static js_value_t *
+bare_foundation_http_url_response_status_code(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_type(env, registry, argv[0], "handle", [NSHTTPURLResponse class], &handle) < 0) return NULL;
+
+  js_value_t *result;
+  err = js_create_int64(env, ((__bridge NSHTTPURLResponse *) handle).statusCode, &result);
+  assert(err == 0);
+
+  return result;
+}
+
+static js_value_t *
+bare_foundation_http_url_response_all_header_fields(js_env_t *env, js_callback_info_t *info) {
+  int err;
+
+  size_t argc = 1;
+  js_value_t *argv[1];
+
+  bare_foundation_registry_t *registry;
+  err = js_get_callback_info(env, info, &argc, argv, NULL, (void **) &registry);
+  assert(err == 0);
+
+  assert(argc == 1);
+
+  void *handle;
+  if (bare_foundation_read_type(env, registry, argv[0], "handle", [NSHTTPURLResponse class], &handle) < 0) return NULL;
+
+  js_value_t *result;
+  err = js_create_object(env, &result);
+  assert(err == 0);
+
+  @autoreleasepool {
+    NSDictionary *fields = ((__bridge NSHTTPURLResponse *) handle).allHeaderFields;
+
+    for (NSString *field in fields) {
+      err = js_set_named_property(env, result, field.UTF8String, bare_foundation__string(env, fields[field]));
+      assert(err == 0);
+    }
+  }
+
+  return result;
+}
diff --git a/lib/http-url-response.js b/lib/http-url-response.js
new file mode 100644
index 0000000..20e0fc5
--- /dev/null
+++ b/lib/http-url-response.js
@@ -0,0 +1,28 @@
+const binding = require('../binding')
+const registry = require('bare-foundation-registry')
+
+module.exports = exports = class FoundationHTTPURLResponse {
+  constructor(opts = {}) {
+    const { tag } = opts
+
+    this._tag = tag
+
+    this._token = binding.claim(this._tag, this)
+  }
+
+  get [registry.tag]() {
+    return this._tag
+  }
+
+  get [registry.handle]() {
+    return binding.handle(this._tag)
+  }
+
+  get statusCode() {
+    return binding.httpURLResponseStatusCode(this._tag)
+  }
+
+  get allHeaderFields() {
+    return binding.httpURLResponseAllHeaderFields(this._tag)
+  }
+}
