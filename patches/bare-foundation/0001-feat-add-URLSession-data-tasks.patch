+++ b/lib/url-session.d.ts
@@ -0,0 +1,43 @@
+import Buffer from 'bare-buffer'
+import { tag, handle, Handle } from 'bare-foundation-registry'
+import FoundationHTTPURLResponse from './http-url-response'
+import FoundationURLRequest from './url-request'
+import FoundationURLSessionDataTask from './url-session-data-task'
+
+/** An error from the URL loading system, as an `NSError`. */
+interface FoundationURLError extends Error {
+  /** The code of the error, such as `-999` for a task that was cancelled. */
+  readonly code: number
+
+  /** The domain of the code, usually `NSURLErrorDomain`. */
+  readonly domain: string
+}
+
+/** A session that runs URL requests, as an `NSURLSession`. */
+interface FoundationURLSession {
+  readonly [tag]: number
+
+  readonly [handle]: Handle
+
+  /**
+   * Make a task that loads `request` once it is resumed, and calls `cb` once it
+   * completes, fails or is cancelled. Until then, the task keeps Bare running.
+   */
+  dataTask(
+    request: FoundationURLRequest,
+    cb: (
+      err: FoundationURLError | null,
+      response: FoundationHTTPURLResponse | null,
+      data: Buffer | null
+    ) => void
+  ): FoundationURLSessionDataTask
+}
+
+declare class FoundationURLSession {
+  protected constructor()
+
+  /** The session of the process, which uses the default configuration. */
+  static readonly shared: FoundationURLSession
+}
+
+export = FoundationURLSession
