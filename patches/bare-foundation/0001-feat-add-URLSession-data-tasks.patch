+++ b/lib/url-session-data-task.d.ts
@@ -0,0 +1,20 @@
+import { tag, handle, Handle } from 'bare-foundation-registry'
+
+/** A task that loads a request into memory, as an `NSURLSessionDataTask`. */
+interface FoundationURLSessionDataTask {
+  readonly [tag]: number
+
+  readonly [handle]: Handle
+
+  /** Start the task, which is suspended when it is made. */
+  resume(): void
+
+  /** Stop the task. Its callback is called with an error whose code is `-999`. */
+  cancel(): void
+}
+
+declare class FoundationURLSessionDataTask {
+  protected constructor()
+}
+
+export = FoundationURLSessionDataTask
