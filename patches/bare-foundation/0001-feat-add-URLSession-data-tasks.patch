@@ -48,6 +48,46 @@ const { RunLoop } = require('bare-foundation')
 binding.scheduleIn(registry.adopt(binding, RunLoop.main))
 ```
 
+### Making a request
+
+`URLRequest` wraps an `NSMutableURLRequest`. Give it a URL, then set the method, the header fields and the body you want to send:
+
+```js
+const { URLRequest } = require('bare-foundation')
+
+const request = new URLRequest('https://example.com/upload')
+
+request.httpMethod = 'POST'
+request.setValue('application/octet-stream', 'Content-Type')
+request.httpBody = Buffer.from('hello')
+```
+
+### Loading a request
+
+`URLSession.shared` wraps the shared `NSURLSession`. A data task loads a request into memory and calls you back once it is done. Tasks start suspended, so resume it:
+
+```js
+const { URLSession } = require('bare-foundation')
+
+const task = URLSession.shared.dataTask(request, (err, response, data) => {
+  if (err) throw err
+
+  console.log(response.statusCode, response.allHeaderFields, data)
+})
+
+task.resume()
+```
+
+The callback is called once, on the thread of the JavaScript environment, and until then the task keeps Bare running. An error has the `code` and `domain` of the `NSError`.
+
+### Cancelling a task
+
+```js
+task.cancel()
+```
+
+The callback is then called with an error whose code is `-999`, `NSURLErrorCancelled`.
+
