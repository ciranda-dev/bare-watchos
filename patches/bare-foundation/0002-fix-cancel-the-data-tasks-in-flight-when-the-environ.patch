diff --git a/test.js b/test.js
index 9ebb495..fad890d 100644
--- a/test.js
+++ b/test.js
@@ -1,5 +1,6 @@
 const test = require('brittle')
 const http = require('bare-http1')
+const { spawnSync } = require('bare-subprocess')
 const registry = require('bare-foundation-registry')
 const binding = require('./binding')
 const { HTTPURLResponse, ProcessInfo, URLRequest, URLSession, URLSessionDataTask } = require('.')
@@ -153,6 +154,13 @@ test('a data task that cannot connect fails', async (t) => {
   task.resume()
 })
 
+test('exiting with a data task in flight', (t) => {
+  const { status, signal } = spawnSync(Bare.argv[0], [require.resolve('./test/fixtures/exit')])
+
+  t.is(signal, null)
+  t.is(status, 0)
+})
+
 test('a wrapper gives out a handle to its object', (t) => {
   const session = URLSession.shared
 
diff --git a/test/fixtures/exit.js b/test/fixtures/exit.js
new file mode 100644
index 0000000..6517865
--- /dev/null
+++ b/test/fixtures/exit.js
@@ -0,0 +1,10 @@
+const http = require('bare-http1')
+const { URLRequest, URLSession } = require('../..')
+
+const server = http.createServer(() => Bare.exit())
+
+server.listen(0, '127.0.0.1', () => {
+  URLSession.shared
+    .dataTask(new URLRequest(`http://127.0.0.1:${server.address().port}/`), () => {})
+    .resume()
+})
