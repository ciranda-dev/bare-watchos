From 61fd18c37d7ceb7542fc0562b2e4e9fe382f0899 Mon Sep 17 00:00:00 2001
From: Daniel de Souza Neris <danielneris01@gmail.com>
Date: Sat, 7 Nov 2026 15:16:37 +0700
Subject: [PATCH 2/2] fix: regenerate the spec with hrpc-swift and
 hyperschema-swift 1.0

The Swift packages of the spec asked for bare-rpc-swift and compact-encoding-swift at `main`,
where bare-rpc-swift 2.0.0 no longer has the `RPCDelegate` the generated `HRPC` is built on.
The 1.0 generators ask for both `from: "1.0.0"`. The JavaScript and C files are regenerated
by the current hrpc, hrpc-c and hyperschema-c.
---
 package.json              | 4 ++--
 spec/hrpc/Package.swift   | 2 +-
 spec/hrpc/hrpc.h          | 9 +++++++++
 spec/hrpc/index.js        | 6 +++---
 spec/hrpc/sync_hrpc.h     | 8 ++++++++
 spec/schema/Package.swift | 2 +-
 spec/schema/sync_schema.h | 8 ++++++++
 7 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/package.json b/package.json
index fdc0e9b..4d50a66 100644
--- a/package.json
+++ b/package.json
@@ -28,9 +28,9 @@
   "devDependencies": {
     "brittle": "^4.0.2",
     "hrpc-c": "^0.1.0",
-    "hrpc-swift": "^0.2.0",
+    "hrpc-swift": "^1.0.0",
     "hyperschema-c": "^0.4.0",
-    "hyperschema-swift": "^0.3.0",
+    "hyperschema-swift": "^1.0.0",
     "lunte": "^1.8.0",
     "prettier": "^3.4.2",
     "prettier-config-holepunch": "^2.0.0"
