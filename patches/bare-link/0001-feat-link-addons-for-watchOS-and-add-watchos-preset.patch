+  const isWatch = hosts.some((host) => host.startsWith('watchos'))
 
   const framework = path.resolve(out, `${name}.${version}.framework`)
   await fs.rm(framework)
@@ -131,7 +132,7 @@ module.exports = async function* createFramework(base, pkg, name, version, hosts
