diff --git a/lib/platform/apple/create-framework.js b/lib/platform/apple/create-framework.js
index f87294a..1855f5e 100644
--- a/lib/platform/apple/create-framework.js
+++ b/lib/platform/apple/create-framework.js
@@ -20,6 +20,7 @@ module.exports = async function* createFramework(base, pkg, name, version, hosts
   if (prebuilds.length === 0) return null
 
