           variant = 'simulator'
           archs.push('x86_64')
           break
+        case 'watchos-arm64':
+          os = 'watchos'
+          archs.push('arm64')
+          break
+        case 'watchos-arm64_32':
+          os = 'watchos'
+          archs.push('arm64_32')
+          break
+        case 'watchos-arm64-simulator':
+          os = 'watchos'
+          variant = 'simulator'
+          archs.push('arm64')
+          break
       }
     }
 
