diff --git a/test/addon.js b/test/addon.js
index d329652..f1d097d 100644
--- a/test/addon.js
+++ b/test/addon.js
@@ -266,6 +266,72 @@ test('addon, ios-arm64 + ios-arm64-simulator + ios-x64-simulator', async (t) =>
   )
 })
 
+test('addon, watchos-arm64 + watchos-arm64_32', async (t) => {
+  const out = await t.tmp()
+  const result = []
+
+  for await (const resource of await link(path.join(fixtures, 'addon', 'index.js'), {
+    out,
+    hosts: ['watchos-arm64', 'watchos-arm64_32']
+  })) {
+    result.push(path.relative(out, resource))
+  }
+
+  t.alike(
+    result,
+    paths([
+      'addon.1.2.3.framework/addon.1.2.3',
+      'addon.1.2.3.framework/Info.plist',
+      'addon.1.2.3.framework'
+    ])
+  )
+
+  const info = fs.readFileSync(path.join(out, 'addon.1.2.3.framework/Info.plist'), 'utf8')
+
+  t.ok(info.includes('<key>MinimumOSVersion</key>\n  <string>8.0</string>'))
+})
+
+test('addon, watchos-arm64-simulator', async (t) => {
+  const out = await t.tmp()
+  const result = []
+
+  for await (const resource of await link(path.join(fixtures, 'addon', 'index.js'), {
+    out,
+    hosts: ['watchos-arm64-simulator']
+  })) {
+    result.push(path.relative(out, resource))
+  }
+
+  t.alike(
+    result,
+    paths([
+      'addon.1.2.3.framework/addon.1.2.3',
+      'addon.1.2.3.framework/Info.plist',
+      'addon.1.2.3.framework'
+    ])
+  )
+})
+
+test('addon, watchos-arm64 + watchos-arm64-simulator + watchos-arm64_32', async (t) => {
+  const out = await t.tmp()
+  const result = []
+
+  for await (const resource of await link(path.join(fixtures, 'addon', 'index.js'), {
+    out,
+    hosts: ['watchos-arm64', 'watchos-arm64-simulator', 'watchos-arm64_32']
+  })) {
+    result.push(path.relative(out, resource))
+  }
+
+  t.alike(
+    result.slice(-2),
+    paths(['addon.1.2.3.xcframework/Info.plist', 'addon.1.2.3.xcframework'])
+  )
+
+  t.ok(fs.existsSync(path.join(out, 'addon.1.2.3.xcframework/watchos-arm64_arm64_32')))
+  t.ok(fs.existsSync(path.join(out, 'addon.1.2.3.xcframework/watchos-arm64-simulator')))
+})
+
 test('addon, android-arm64', async (t) => {
   const out = await t.tmp()
   const result = []
