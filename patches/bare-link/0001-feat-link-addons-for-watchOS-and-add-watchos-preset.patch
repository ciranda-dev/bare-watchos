   yield info
 
   await sign(framework, opts)
@@ -140,7 +141,7 @@ module.exports = async function* createFramework(base, pkg, name, version, hosts
   return framework
 }
 
-function createPropertyList(isMac, name, version) {
+function createPropertyList(isMac, isWatch, name, version) {
   const executable = `${name}.${version}`
 
   const { major, minor, patch } = Version.parse(version)
@@ -163,7 +164,7 @@ function createPropertyList(isMac, name, version) {
   <key>CFBundlePackageType</key>
   <string>FMWK</string>
   <key>${isMac ? 'LSMinimumSystemVersion' : 'MinimumOSVersion'}</key>
-  <string>${isMac ? '13.0' : '15.0'}</string>
+  <string>${isMac ? '13.0' : isWatch ? '8.0' : '15.0'}</string>
 </dict>
 </plist>
 `
