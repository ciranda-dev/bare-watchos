diff --git a/lib/platform/apple.js b/lib/platform/apple.js
index 2582dce..2080f99 100644
--- a/lib/platform/apple.js
+++ b/lib/platform/apple.js
@@ -8,7 +8,9 @@ module.exports = async function* apple(base, pkg, name, version, opts = {}) {
   const archs = new Map([
     ['macos', []],
     ['ios', []],
-    ['ios-simulator', []]
+    ['ios-simulator', []],
+    ['watchos', []],
+    ['watchos-simulator', []]
   ])
 
   for (const host of hosts) {
@@ -26,6 +28,13 @@ module.exports = async function* apple(base, pkg, name, version, opts = {}) {
       case 'ios-x64-simulator':
         arch = archs.get('ios-simulator')
         break
+      case 'watchos-arm64':
+      case 'watchos-arm64_32':
+        arch = archs.get('watchos')
+        break
+      case 'watchos-arm64-simulator':
